#!/bin/bash
# Runs adb against the CardputerZero, recovering the link if it has dropped. The device
# sometimes goes "offline" under load; "adb reconnect offline" usually brings it back, and the
# adb server is only restarted as a last resort because that interrupts other adb sessions.
ready() { [ "$(adb get-state 2>/dev/null | head -1)" = device ]; }
if ! ready; then
  for i in $(seq 1 12); do
    adb reconnect offline >/dev/null 2>&1
    sleep 3
    ready && break
  done
  if ! ready; then
    adb kill-server >/dev/null 2>&1; adb start-server >/dev/null 2>&1
    timeout 30 adb wait-for-device
  fi
fi
exec adb "$@"
